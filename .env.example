# Shared-resource configuration. Copy to `.env.local` and fill in.
# `.env.local` is gitignored. Never commit real credentials.
#
# Variables specific to a single use case live in that use case's own
# .env.example, not here.

# ---------------------------------------------------------------------------
# Nutanix Prism Central
# ---------------------------------------------------------------------------
PRISM_CENTRAL_ENDPOINT=https://pc.lab.example.com:9440
PRISM_CENTRAL_USERNAME=svc-ai-portal
PRISM_CENTRAL_PASSWORD=
# Lab endpoints with self-signed certificates only.
PRISM_CENTRAL_INSECURE_TLS=false

# ---------------------------------------------------------------------------
# Nutanix Kubernetes Platform
# ---------------------------------------------------------------------------
NKP_CLUSTER_NAME=nkp-ai-prod
NKP_API_SERVER=https://nkp-ai-prod.lab.example.com:6443
NKP_NAMESPACE=ai-portal
# Leave unset in cluster; the mounted service account is used instead.
NKP_KUBECONFIG=

# ---------------------------------------------------------------------------
# OpenRouter model gateway  (chat + embeddings + rerank)
# ---------------------------------------------------------------------------
# The gateway the backends target: reachable from the NKP cluster, and the only
# one of the two that serves embeddings.
#
# Both chat models return a separate `reasoning` field whose tokens count
# against max_tokens. Budget at least 1024 or the answer truncates mid-trace.
#
# `:free` variants are capped per ACCOUNT at 50 requests/day (20/min) below $10
# of lifetime credits, 1000/day above it. Batch embeddings — one request takes
# 256 inputs. The embedding model has no paid variant to fall back to.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
OPENROUTER_CHAT_MODEL=nvidia/nemotron-3-super-120b-a12b:free
OPENROUTER_CHAT_MODEL_FAST=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free
OPENROUTER_EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b:free
# Fixed at 2048; the model rejects any other value. Exceeds pgvector's 2000-dim
# index limit, so indexes are built on a halfvec cast.
OPENROUTER_EMBEDDING_DIMENSIONS=2048
OPENROUTER_RERANK_MODEL=nvidia/llama-nemotron-rerank-vl-1b-v2:free
OPENROUTER_MAX_TOKENS=1536

# ---------------------------------------------------------------------------
# Nutanix Enterprise AI  (on-premises; not reachable from the NKP cluster)
# ---------------------------------------------------------------------------
# Retained for workstation use and for when cluster egress is opened. Publishes
# no embedding model, so it cannot serve the retrieval path.
NAI_ENDPOINT=https://nai-dre.corp.p10y.ntnxdpro.com/enterpriseai/gateway/v1
NAI_API_KEY=
NAI_CHAT_MODEL=nemotron3-fp4-uni
NAI_EMBEDDING_MODEL=

# ---------------------------------------------------------------------------
# Casino data platform
# ---------------------------------------------------------------------------
# Holds cms_raw (simulated CMS), analytics (the shared contracts), and one
# uc_<slug> schema per use case. Not yet deployed.
CASINO_DB_HOST=casino-postgres.casino-ai-portal.svc.cluster.local
CASINO_DB_PORT=5432
CASINO_DB_NAME=casino
# Per-use-case role. The portal itself does not connect to this database.
CASINO_DB_USER=
CASINO_DB_PASSWORD=
CASINO_DB_SSLMODE=disable

# ---------------------------------------------------------------------------
# Model registry (MLflow)
# ---------------------------------------------------------------------------
# The run id it issues is the model_version written to player_scores and
# decision_log. Not yet deployed.
MLFLOW_TRACKING_URI=http://mlflow.casino-ai-portal.svc.cluster.local:5000
MLFLOW_EXPERIMENT_PREFIX=casino
MLFLOW_TRACKING_TOKEN=

# ---------------------------------------------------------------------------
# Vector database
# ---------------------------------------------------------------------------
# pgvector inside the casino Postgres. Provisioned but unused: the inference
# endpoint publishes no embedding model, so there is nothing to populate a
# collection with.
VECTOR_DB_KIND=pgvector
VECTOR_DB_ENDPOINT=postgresql://casino-postgres.casino-ai-portal.svc.cluster.local:5432/casino
VECTOR_DB_API_KEY=
VECTOR_DB_DATABASE=casino

# ---------------------------------------------------------------------------
# Use-case backends
# ---------------------------------------------------------------------------
# None of the six casino use cases has a backend yet; each DESIGN.md specifies
# the API it will expose. Set these when the backends exist.
PREDICTIVE_LTV_SCORING_API_URL=
CHURN_RISK_MODELING_API_URL=
DYNAMIC_OFFER_ENGINE_API_URL=
WIN_BACK_CAMPAIGNS_API_URL=
SLOT_TABLE_PERFORMANCE_API_URL=
REVENUE_MANAGEMENT_API_URL=
