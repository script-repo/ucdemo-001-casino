{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-portal.local/schemas/resources.json",
  "title": "Shared-resource catalogue",
  "description": "Contract for shared-resources/resources.json.",
  "type": "object",
  "additionalProperties": false,
  "required": ["resources"],
  "properties": {
    "$schema": { "type": "string" },
    "resources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "category", "summary", "docs", "env"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
            "description": "Must match the folder name under shared-resources/."
          },
          "name": { "type": "string" },
          "category": { "type": "string" },
          "summary": { "type": "string" },
          "docs": { "type": "string" },
          "env": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "required", "secret", "example", "description"],
              "properties": {
                "name": { "type": "string", "pattern": "^[A-Z0-9_]+$" },
                "required": { "type": "boolean" },
                "secret": { "type": "boolean" },
                "example": { "type": "string" },
                "description": { "type": "string" }
              }
            }
          }
        }
      }
    }
  }
}
